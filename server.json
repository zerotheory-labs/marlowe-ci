{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.zerotheory-labs/marlowe-ci",
  "title": "Marlowe CI / Guard",
  "description": "13 read-only MCP security tools: AppSec, OSV CVEs, ScopeGate recon, DFIR, and Shirudo eBPF/TPM.",
  "version": "0.7.1",
  "repository": {
    "url": "https://github.com/zerotheory-labs/marlowe-ci",
    "source": "github"
  },
  "websiteUrl": "https://zerotheorylabs.com/marlowe-ci",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@zerotheory-labs/marlowe-ci",
      "version": "0.7.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
