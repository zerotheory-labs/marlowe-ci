{
  "name": "@zerotheory-labs/marlowe-ci",
  "version": "0.6.0",
  "mcpName": "io.github.zerotheory-labs/marlowe-ci",
  "description": "Marlowe CI / Guard — Source-available security guardrails for Claude Code hooks, MCP agents, GitHub Actions, and pre-commit workflows.",
  "bin": {
    "marlowe-ci": "bin/marlowe-ci.cjs"
  },
  "main": "./src/engine/verdict.cjs",
  "homepage": "https://github.com/zerotheory-labs/marlowe-ci",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerotheory-labs/marlowe-ci.git"
  },
  "bugs": {
    "url": "https://github.com/zerotheory-labs/marlowe-ci/issues"
  },
  "files": [
    "bin/",
    "src/",
    "action.yml",
    "server.json",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "bench": "node benchmarks/run-benchmarks.cjs",
    "bench:artex": "node benchmarks/run-artex-purple-team.cjs",
    "bench:corpus": "node benchmarks/run-corpus-audit.cjs --out benchmarks/corpus-results.json",
    "self-check": "node bin/marlowe-ci.cjs scan --path . --no-osv",
    "prepublishOnly": "npm test && npm run self-check"
  },
  "keywords": [
    "security",
    "appsec",
    "claude-code",
    "mcp",
    "github-actions",
    "sarif",
    "ssrf",
    "ai-security"
  ],
  "author": "Zero Theory Labs",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {}
}
